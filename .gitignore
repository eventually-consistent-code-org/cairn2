node_modules/
.env
# cairn's working state stays local; memory cards are the one part that
# ships with the repo (#388). Four lines because git cannot re-include a
# path whose parent directory is excluded.
.cairn/*
!.cairn/memory/
.cairn/memory/*
!.cairn/memory/cards/
/cairn.json

# superpowers SDD scratch (ledgers, briefs, review packages)
.superpowers/

# local checkout of the evals-archive branch (eval suite, review corpus, planning history)
/evals-archive/

# OS cruft -- the plugin directory scan blocks a submission that ships these
.DS_Store
Thumbs.db
desktop.ini
__MACOSX/
