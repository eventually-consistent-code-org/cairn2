    {
      "type": "text",
      "id": "hk_sub",
      "x": 40,
      "y": 996,
      "width": 640.9,
      "height": 32.5,
      "strokeColor": "#4a5b6b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 700010,
      "version": 1,
      "versionNonce": 700012,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "not instructions, not tools — nine scripts Claude Code fires around every tool call,\nwhether or not a verb is running. Three kinds, and the difference is the whole point.",
