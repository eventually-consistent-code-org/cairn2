{
  "$schema": "cairn 2.0 project config. tracker = your single source of truth for work items. Tokens come from env vars, never this file. Optional `user` block: {\"handle\": \"<your tracker username>\", \"mode\": \"vibe\"|\"engineer\"} — handle enables ownership tracking, mode picks the collaboration posture (vibe = cairn drives, engineer = you pair; default vibe). _alternatives below are example `tracker` blocks for the other supported backends — copy the one you want over the active `tracker` block above and delete `_alternatives`.",
  "tracker": {
    "type": "github",
    "config": { "repo": "owner/name" }
  },
  "_tracker_local": {
    "$comment": "Zero-credential option — issues live in this repo (commit the dir). Copy over `tracker` to enable.",
    "type": "local",
    "config": { "dir": ".tracker", "prefix": "proj",
      "states": { "review": "in_progress", "blocked": "open" } }
  },
  "_docs": {
    "$comment": "Optional documentation connector — publishes README + docs/ as a page tree. Copy to `docs` to enable. Credentials come from env vars named here, never this file. Alternative: `docusaurus` writes markdown into a local Docusaurus site checkout (no credentials; autoCommit commits in the site repo after publish, never pushes).",
    "connector": "confluence",
    "config": {
      "baseUrl": "https://your-domain.atlassian.net/wiki",
      "spaceKey": "DOCS",
      "emailEnv": "CONFLUENCE_EMAIL",
      "tokenEnv": "CONFLUENCE_API_TOKEN"
    }
  },
  "_docs_docusaurus": {
    "$comment": "Docusaurus example — copy to `docs` to enable.",
    "connector": "docusaurus",
    "config": { "sitePath": "../my-docs-site", "docsDir": "docs", "autoCommit": false }
  },
  "agents": { "model": "auto" },
  "continuity": {
    "resume": "prompt",
    "checkpoint": true,
    "wipCommits": false,
    "recallIndex": { "enabled": true, "maxCards": 20 }
  },
  "leakGuard": {
    "enabled": true,
    "allow": [],
    "extraPatterns": []
  },
  "_seats": {
    "$comment": "Optional seat roster control — copy to `seats` to enable. Absent block = every shipped default seat enabled (today's behavior). `enabled` picks AND orders the roster by seat name; `disabled` removes names. `dispatch` is the project dispatch dial a verb's inherit resolves to: \"auto\" (the default when absent) = diff-derived signals pick which seats fire (a seat declaring no signals always fires; low-yield seats gate on evidence once a seat has ten dispatches of history — never security or dose-full seats), \"off\" = the full roster fires on every pass, the explicit opt-in. Definitions are files, never config: project seats in .cairn/roles/*.md override the shipped defaults (templates/seats/) by name. Internal seats are framing lenses — cheap, same-model; peers remain the genuinely adversarial external council.",
    "enabled": ["correctness", "clarity", "architecture", "security", "tests"],
    "disabled": [],
    "dispatch": "off"
  },
  "_alternatives": {
    "gitlab": {
      "type": "gitlab",
      "config": {
        "baseUrl": "https://gitlab.com",
        "project": "owner/name",
        "tokenEnv": "GITLAB_TOKEN",
        "extraLabels": []
      }
    },
    "jira": {
      "type": "jira",
      "config": {
        "baseUrl": "https://your-domain.atlassian.net",
        "projectKey": "PROJ",
        "issueType": "Task",
        "emailEnv": "JIRA_EMAIL",
        "tokenEnv": "JIRA_API_TOKEN",
        "transitions": { "in_progress": "In Progress", "closed": "Done", "review": "In Review" }
      }
    },
    "asana": {
      "type": "asana",
      "config": {
        "projectGid": "1234567890123456",
        "tokenEnv": "ASANA_TOKEN"
      }
    },
    "azure-boards": {
      "type": "azure-boards",
      "config": {
        "orgUrl": "https://dev.azure.com/your-org",
        "project": "your-project",
        "workItemType": "Issue",
        "patEnv": "AZURE_DEVOPS_PAT",
        "apiVersion": "7.0",
        "states": { "in_progress": "Doing", "closed": "Done", "open": "To Do" }
      }
    },
    "clickup": {
      "type": "clickup",
      "config": {
        "defaultListId": "900123456",
        "spaceId": "90123456",
        "tokenEnv": "CLICKUP_TOKEN",
        "statuses": { "open": "to do", "in_progress": "in progress", "closed": "complete" }
      }
    },
    "linear": {
      "type": "linear",
      "config": {
        "teamId": "9cfb482a-81e3-4154-b5b9-2c805e70a02d",
        "apiKeyEnv": "LINEAR_API_KEY"
      }
    }
  }
}
